prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: libavcodec
Description: FFmpeg codec library
Version: 63.1.102
Requires: 
Requires.private: libswresample >= 7.1.102, libavutil >= 61.1.102
Conflicts:
Libs: -L${libdir}  -lavcodec 
Libs.private: -lm -ldav1d -lmp3lame -lm -lx264 -lx265 -lm -lstdc++ -lole32 -luser32 -lz
Cflags: -I${includedir}
